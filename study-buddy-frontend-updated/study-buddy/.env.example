# GEMINI_API_KEY: Required for the AI features (quizzes, flashcards, study assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Authentication
# MUST be exactly the same string as jwt.secret in the Spring backend (Spring signs the tokens, this server verifies them).
JWT_SECRET="unicollab-secure-jwt-secret-key-32-chars-minimum-token"

# Spring backend that handles sign-in, OTP registration, forgot password and token refresh.
# The browser calls this directly (Spring's CORS already allows http://localhost:3000); the server uses it to load a user's profile.
VITE_AUTH_API="http://localhost:8080/api"

# Database Configuration (MySQL / Spring Boot)
DATABASE_URL="jdbc:mysql://localhost:3306/studybuddy_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
DATABASE_USERNAME="root"
DATABASE_PASSWORD="password"

# Cloud Storage Configuration (Cloudinary / File Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"


# --- Sign-in ---
# Students register with name + email + password, then confirm a 6-digit code emailed to them (OTP) before the account is created.
# Anyone can sign in with email + password, and can reset a forgotten password with an emailed 6-digit code.
# ADMIN registration needs TWO codes: one emailed to the admin, one emailed to this developer address.
# REQUIRED for admin registration (it is refused if unset).
DEVELOPER_EMAIL=""
# Optional: comma-separated emails allowed to register as admin (empty = any email, still needs both codes)
# ADMIN_EMAILS="admin1@example.com,admin2@example.com"
# ACCESS_TOKEN_TTL=1d
# SMTP (needs: npm i nodemailer). If unset, codes are printed in the server console AND shown on screen in dev.
# With NODE_ENV=production and no working SMTP, registration / password reset return a 503 instead of exposing codes.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM="Study Buddy <you@gmail.com>"
